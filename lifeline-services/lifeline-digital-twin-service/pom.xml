<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tianxin.lifeline</groupId>
        <artifactId>lifeline-services</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lifeline-digital-twin-service</artifactId>

    <name>lifeline-digital-twin-service</name>
    <description>数字孪生聚合服务：模型数据聚合/实时映射/预警定位/仿真推演，纯只读编排既有服务能力，不自建存储（端口9010）</description>

    <dependencies>
        <!-- Web 容器与REST 接口（同步 MVC + CompletableFuture 编排） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验（@Valid / jakarta.validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Redis：实时映射批量读 rt:{deviceId}、预警定位结果缓存、仿真任务状态承载 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Caffeine 本地 L1 缓存（模型数据 30s） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 平台公共核心：常量/统一响应体/异常/雪花ID -->
        <dependency>
            <groupId>com.tianxin.lifeline</groupId>
            <artifactId>lifeline-common-core</artifactId>
        </dependency>
        <!-- 平台公共web：全局异常处理/Jackson配置 -->
        <dependency>
            <groupId>com.tianxin.lifeline</groupId>
            <artifactId>lifeline-common-web</artifactId>
        </dependency>
        <!-- 平台公共安全：JWT认证过滤器/SecurityContext -->
        <dependency>
            <groupId>com.tianxin.lifeline</groupId>
            <artifactId>lifeline-common-security</artifactId>
        </dependency>
        <!-- 服务间调用契约：pipe-asset/monitor/warning Feign 客户端与共享DTO -->
        <dependency>
            <groupId>com.tianxin.lifeline</groupId>
            <artifactId>lifeline-service-api</artifactId>
        </dependency>

        <!-- Nacos 服务注册发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Actuator 健康检查端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>lifeline-digital-twin-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
